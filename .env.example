# Copy to .env for local development. On Forge, set these in the site's
# Environment tab — the deploy script writes no .env file.

# Public base URL of this site (used for canonical URLs and sitemap)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Student/teacher portal, still served by the Laravel app
NUXT_PUBLIC_PORTAL_URL=https://mijn.bijlesbeta.nl

# Laravel application that receives contact submissions.
# Leave empty locally: submissions are logged to the console instead of sent.
NUXT_LARAVEL_API_URL=
NUXT_LARAVEL_API_TOKEN=

# The portal's external-registration endpoints, which /aanmelden and
# /solliciteren post to (register-external-full, register-external-applicant,
# upload-external-resume). These authenticate with a shared secret header
# rather than a bearer token, so the key is the credential — keep it out of
# the repo and set it in Forge's Environment tab.
# Leave empty locally: submissions are logged to the console instead of sent.
NUXT_PORTAL_API_URL=
NUXT_PORTAL_SECRET_KEY=

# SMTP for the office copy of every form submission.
#
# The portal owns the mail to the visitor (the password-set link on a signup,
# the confirmation on an application) — this is the copy the office gets, and
# it is sent whether or not the portal accepted the submission. It is what
# stands between a portal outage, or a single field the portal refuses, and a
# lost lead. It also carries the answers themselves, which the portal's own
# admin notifications do not.
#
# Reuse the portal's SMTP credentials so there is one sending domain and one
# set of SPF/DKIM records, not two. Leave empty locally: the copy is logged to
# the console instead of sent.
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=587
NUXT_MAIL_USER=
NUXT_MAIL_PASSWORD=
NUXT_MAIL_FROM="Bijles Beta <contact@bijlesbeta.nl>"

# Where the copies land. Sollicitaties go to the separate mailbox the live site
# names beside that form; contact and aanmeldingen to the contact address.
NUXT_OFFICE_EMAIL=contact@bijlesbeta.nl
NUXT_APPLICATIONS_EMAIL=info@bijlesbeta.nl

# Unlocks GET /api/_diagnose?key=<this>, which reports which variables the Node
# process can actually see and what the SMTP server says when we connect to it.
# The route 404s while this is empty, so it does not exist unless you opt in —
# and a 404 with the key set means the environment is not reaching the process
# at all (the Forge daemon needs `node --env-file=.env`). Unset it again once
# the deploy is healthy.
NUXT_DIAGNOSE_KEY=

# Google Tag Manager container. Leave empty and nothing loads at all — set it
# only on the domain whose traffic should reach the live property, so staging
# never reports into it. bijlesbeta.nl runs GTM-MJCC44HR.
NUXT_PUBLIC_GTM_ID=

# Port the Node server listens on (Forge daemon + nginx proxy target)
PORT=3000
